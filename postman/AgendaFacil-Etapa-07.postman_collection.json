  "item": [
    {
      "name": "Tarefas - GET - Listar todas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tarefas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Resposta em JSON', function () { pm.response.to.have.header('Content-Type', /application\\/json/); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Tarefas - GET - Consultar por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tarefas/{{id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Tarefas - POST - Criar",
      "request": {
        "method": "POST",
        "header": [
