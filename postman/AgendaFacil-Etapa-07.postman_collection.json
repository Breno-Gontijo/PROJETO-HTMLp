    {
      "name": "Tarefas - POST - Validar erro (sem título)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Sem os campos obrigatórios\",\n  \"data\": \"2026-12-10\",\n  \"horario\": \"15:00\",\n  \"categoria\": \"estudos\"\n}"
        },
        "url": "{{baseUrl}}/api/tarefas"
      },
      "event": [
