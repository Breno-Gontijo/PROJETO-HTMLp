            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Tarefa criada pelo Postman\",\n  \"descricao\": \"Teste de criação pela API\",\n  \"data\": \"2026-12-10\",\n  \"horario\": \"15:00\",\n  \"categoria\": \"estudos\"\n}"
        },
        "url": "{{baseUrl}}/api/tarefas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "if (body.dados && body.dados.id) pm.collectionVariables.set('id', body.dados.id);"
            ]
          }
        }
      ]
    },
